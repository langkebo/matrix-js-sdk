{
    "name": "matrix-js-sdk",
    "version": "40.2.0",
    "description": "Matrix Client-Server SDK for Javascript",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "prepare": "pnpm build",
        "start": "echo THIS IS FOR LEGACY PURPOSES ONLY. && babel src -w -s -d lib --verbose --extensions \".ts,.js\"",
        "clean": "rimraf lib node_modules/.tsbuildinfo",
        "build": "pnpm clean && pnpm build:compile && pnpm build:types",
        "build:types": "tsc -p tsconfig-build.json --emitDeclarationOnly",
        "build:compile": "babel -d lib --verbose --extensions \".ts,.js\" src && node scripts/fix-esm-specifiers.mjs",
        "gendoc": "typedoc",
        "lint": "pnpm lint:types && pnpm test:types && pnpm quality:type-coverage && pnpm lint:js && pnpm lint:workflows && pnpm quality:swallow-fallbacks && pnpm quality:debt-markers",
        "lint:js": "eslint src spec && node --max-old-space-size=8192 ./node_modules/prettier/bin/prettier.cjs --check .",
        "lint:js-fix": "node --max-old-space-size=8192 ./node_modules/prettier/bin/prettier.cjs --log-level=warn --write . && eslint --fix src spec",
        "lint:types": "tsc --noEmit",
        "lint:types:real-backend": "tsc -p tsconfig.real-backend.json --noEmit",
        "test:types": "pnpm build:types && tsd",
        "lint:workflows": "find .github/workflows -type f \\( -iname '*.yaml' -o -iname '*.yml' \\) | xargs -I {} sh -c 'echo \"Linting {}\"; action-validator \"{}\"'",
        "lint:knip": "knip",
        "test": "vitest run",
        "test:real-backend": "pnpm test:real-backend:smoke && pnpm test:real-backend:setup && pnpm test:real-backend:batch",
        "test:real-backend:batch": "node scripts/run-real-backend-batch.mjs",
        "test:real-backend:smoke": "node scripts/run-real-backend-with-ca.mjs pnpm exec vitest run --config vitest.real-backend.config.ts spec/integ/real-backend/smoke.spec.ts",
        "test:real-backend:setup": "node scripts/run-real-backend-with-ca.mjs node scripts/ensure-real-backend-users.mjs",
        "test:real-backend:with-ca": "node scripts/run-real-backend-with-ca.mjs",
        "test:real-backend:tsx": "node scripts/run-real-backend-with-ca.mjs npx tsx",
        "test:real-backend:verification": "node scripts/run-real-backend-with-ca.mjs pnpm exec vitest run --config vitest.real-backend.config.ts spec/integ/real-backend/key-verification-manager.spec.ts",
        "test:real-backend:device": "node scripts/run-real-backend-with-ca.mjs pnpm exec vitest run --no-file-parallelism --config vitest.real-backend.config.ts spec/integ/real-backend/device-manager.spec.ts spec/integ/real-backend/device-step2.spec.ts spec/integ/real-backend/device-delete-devices.spec.ts spec/integ/real-backend/device-list-updates.spec.ts",
        "test:watch": "vitest --watch",
        "test:perf": "vitest run spec/perf",
        "perf:ci": "pnpm test:perf",
        "perf:baseline": "node scripts/perf/benchmark-baseline.mjs",
        "perf:memory": "node scripts/perf/measure-memory.mjs",
        "perf:compare": "node scripts/perf/generate-comparison-report.mjs",
        "coverage": "pnpm test --coverage",
        "quality:coverage:critical": "node scripts/quality/check-critical-coverage.mjs coverage/lcov.info",
        "quality:exports": "node scripts/quality/check-exports-docs.mjs",
        "quality:entrypoints": "node scripts/quality/check-entrypoint-layering.mjs",
        "quality:sdk-contracts": "node scripts/quality/check-sdk-contract-alignment.mjs",
        "quality:manager-codegen": "node scripts/quality/check-manager-codegen-coverage.mjs",
        "quality:room-space-search": "node scripts/quality/check-room-space-search-granular-coverage.mjs",
        "quality:sync-tags-relations": "node scripts/quality/check-sync-tags-relations-granular-coverage.mjs",
        "quality:accountdata-notifications": "node scripts/quality/check-accountdata-notifications-granular-coverage.mjs",
        "quality:auth-umbrella": "node scripts/quality/check-auth-umbrella-granular-coverage.mjs",
        "quality:password-identity": "node scripts/quality/check-password-identity-granular-coverage.mjs",
        "quality:presence-typing-receipts-ephemeral": "node scripts/quality/check-presence-typing-receipts-ephemeral-granular-coverage.mjs",
        "quality:device-todevice-verification": "node scripts/quality/check-device-todevice-verification-granular-coverage.mjs",
        "quality:admin-server-federation": "node scripts/quality/check-admin-server-federation-granular-coverage.mjs",
        "quality:worker-admin": "node scripts/quality/check-worker-admin-granular-coverage.mjs",
        "quality:background-update": "node scripts/quality/check-background-update-granular-coverage.mjs",
        "quality:cas": "node scripts/quality/check-cas-granular-coverage.mjs",
        "quality:burn-after-read": "node scripts/quality/check-burn-after-read-granular-coverage.mjs",
        "quality:captcha": "node scripts/quality/check-captcha-granular-coverage.mjs",
        "quality:event-report": "node scripts/quality/check-event-report-granular-coverage.mjs",
        "quality:ai-connection": "node scripts/quality/check-ai-connection-granular-coverage.mjs",
        "quality:external-service": "node scripts/quality/check-external-service-granular-coverage.mjs",
        "quality:user-directory": "node scripts/quality/check-user-directory-granular-coverage.mjs",
        "quality:telemetry": "node scripts/quality/check-telemetry-granular-coverage.mjs",
        "quality:guest": "node scripts/quality/check-guest-granular-coverage.mjs",
        "quality:generated-dto-strictness": "node scripts/quality/check-generated-dto-strictness.mjs",
        "quality:public-jsdoc-examples": "node scripts/quality/check-public-jsdoc-examples.mjs",
        "quality:coverage-report": "node scripts/quality/generate-coverage-report.mjs",
        "quality:swallow-fallbacks": "node scripts/quality/check-swallow-fallbacks.mjs",
        "quality:debt-markers": "node scripts/quality/scan-technical-debt.mjs",
        "quality:log-sensitive": "node scripts/quality/check-log-sensitive.mjs",
        "quality:type-coverage": "node scripts/quality/check-type-coverage.mjs",
        "contract:sync": "node scripts/contract-sync.mjs",
        "contract:sync:drafts": "node scripts/contract-sync.mjs --render-drafts",
        "contract:check": "node scripts/contract-sync.mjs --check && node scripts/sdk-contract-codegen.mjs --check",
        "contract:codegen": "node scripts/sdk-contract-codegen.mjs",
        "contract:codegen:check": "node scripts/sdk-contract-codegen.mjs --check",
        "contract:pin-docs": "node scripts/pin-module-docs.mjs",
        "generate:manager-extensions": "node scripts/generate-manager-extensions.mjs",
        "quality:contracts": "pnpm quality:exports && pnpm quality:entrypoints && pnpm quality:sdk-contracts && pnpm contract:check && pnpm contract:codegen:check && pnpm quality:generated-dto-strictness && pnpm quality:public-jsdoc-examples",
        "quality:report": "node scripts/quality-report.mjs",
        "quality:large-file-check": "node scripts/quality/check-large-file-changes.mjs",
        "audit:high": "pnpm audit --audit-level=high",
        "prepublishOnly": "pnpm lint && pnpm test && pnpm quality:report && pnpm audit:high && node scripts/check-bundle-size.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/matrix-org/matrix-js-sdk.git"
