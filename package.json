{
    "name": "matrix-js-sdk",
    "version": "40.2.0",
    "description": "Matrix Client-Server SDK for Javascript",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "prepare": "pnpm build",
        "start": "echo THIS IS FOR LEGACY PURPOSES ONLY. && babel src -w -s -d lib --verbose --extensions \".ts,.js\"",
        "clean": "rimraf lib",
        "build": "pnpm clean && pnpm build:compile && pnpm build:types",
        "build:types": "tsc -p tsconfig-build.json --emitDeclarationOnly",
        "build:compile": "babel -d lib --verbose --extensions \".ts,.js\" src",
        "gendoc": "typedoc",
        "lint": "pnpm lint:types && pnpm lint:js && pnpm lint:workflows",
        "lint:js": "eslint --max-warnings 0 src spec && prettier --check .",
        "lint:js-fix": "prettier --log-level=warn --write . && eslint --fix src spec",
        "lint:types": "tsc --noEmit",
        "lint:workflows": "find .github/workflows -type f \\( -iname '*.yaml' -o -iname '*.yml' \\) | xargs -I {} sh -c 'echo \"Linting {}\"; action-validator \"{}\"'",
        "lint:knip": "knip",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "coverage": "pnpm test --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/matrix-org/matrix-js-sdk.git"
    },
    "keywords": [
        "matrix-org"
    ],
    "type": "module",
    "main": "./lib/index.js",
    "browser": "./lib/browser-index.js",
    "typings": "./lib/index.d.ts",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        },
        "./crypto": {
            "import": "./lib/crypto-api/index.js",
            "types": "./lib/crypto-api/index.d.ts"
        },
        "./webrtc": {
            "import": "./lib/webrtc/index.js",
            "types": "./lib/webrtc/index.d.ts"
        },
        "./friend": {
            "import": "./lib/friend/index.js",
            "types": "./lib/friend/index.d.ts"
        },
        "./dm": {
            "import": "./lib/dm/index.js",
            "types": "./lib/dm/index.d.ts"
        },
        "./voice": {
            "import": "./lib/voice/index.js",
            "types": "./lib/voice/index.d.ts"
        },
        "./notification": {
            "import": "./lib/notification/index.js",
            "types": "./lib/notification/index.d.ts"
        },
        "./admin": {
            "import": "./lib/admin/index.js",
            "types": "./lib/admin/index.d.ts"
        },
        "./cache": {
            "import": "./lib/cache/index.js",
            "types": "./lib/cache/index.d.ts"
        },
        "./models": {
            "import": "./lib/models/index.js",
            "types": "./lib/models/index.d.ts"
        },
        "./store": {
            "import": "./lib/store/index.js",
            "types": "./lib/store/index.d.ts"
        },
        "./http-api": {
            "import": "./lib/http-api/index.js",
            "types": "./lib/http-api/index.d.ts"
        },
        "./client": {
            "import": "./lib/client.js",
            "types": "./lib/client.d.ts"
        },
        "./models/room": {
            "import": "./lib/models/room.js",
            "types": "./lib/models/room.d.ts"
        },
        "./models/event": {
            "import": "./lib/models/event.js",
            "types": "./lib/models/event.d.ts"
        },
        "./@types/partials": {
            "import": "./lib/@types/partials.js",
            "types": "./lib/@types/partials.d.ts"
        },
        "./@types/PushRules": {
            "import": "./lib/@types/PushRules.js",
            "types": "./lib/@types/PushRules.d.ts"
        },
        "./timeline-window": {
            "import": "./lib/timeline-window.js",
            "types": "./lib/timeline-window.d.ts"
        },
        "./src/manager-extensions": {
            "import": "./lib/manager-extensions/index.js",
            "types": "./lib/manager-extensions/index.d.ts"
        },
        "./src/telemetry": {
            "import": "./lib/telemetry/index.js",
            "types": "./lib/telemetry/index.d.ts"
        }
    },
    "sideEffects": false,
    "author": "matrix.org",
    "license": "Apache-2.0",
    "files": [
        "lib",
        "src",
        "git-revision.txt",
        "CHANGELOG.md",
        "CONTRIBUTING.rst",
        "LICENSE",
        "README.md",
        "package.json",
        "release.sh"
    ],
    "dependencies": {
        "@babel/runtime": "^7.28.6",
        "@matrix-org/matrix-sdk-crypto-wasm": "^17.1.0",
        "another-json": "^0.2.0",
        "bs58": "^6.0.0",
        "content-type": "^1.0.5",
        "jwt-decode": "^4.0.0",
        "loglevel": "^1.9.2",
        "matrix-events-sdk": "0.0.1",
        "matrix-widget-api": "^1.17.0",
        "oidc-client-ts": "^3.4.1",
        "p-retry": "^7.1.1",
        "sdp-transform": "^3.0.0",
        "unhomoglyph": "^1.0.6",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@action-validator/cli": "^0.6.0",
        "@action-validator/core": "^0.6.0",
        "@babel/cli": "^7.28.6",
        "@babel/core": "^7.29.0",
        "@babel/eslint-parser": "^7.28.6",
        "@babel/eslint-plugin": "^7.27.1",
        "@babel/plugin-proposal-decorators": "^7.29.0",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-class-properties": "^7.28.6",
        "@babel/plugin-transform-numeric-separator": "^7.28.6",
        "@babel/plugin-transform-object-rest-spread": "^7.28.6",
        "@babel/plugin-transform-runtime": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-typescript": "^7.28.5",
        "@fetch-mock/vitest": "^0.2.18",
        "@matrix-org/olm": "3.2.15",
        "@peculiar/webcrypto": "^1.5.0",
        "@stylistic/eslint-plugin": "^5.9.0",
        "@types/content-type": "^1.1.9",
        "@types/debug": "^4.1.12",
        "@types/node": "^22.19.13",
        "@types/sdp-transform": "^2.15.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/eslint-plugin": "^1.6.9",
        "@vitest/ui": "^4.0.18",
        "babel-plugin-search-and-replace": "^1.1.1",
        "debug": "^4.4.3",
        "eslint": "8.57.1",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^62.7.1",
        "eslint-plugin-matrix-org": "^3.0.0",
        "eslint-plugin-n": "^14.0.0",
        "eslint-plugin-tsdoc": "^0.5.2",
        "eslint-plugin-unicorn": "^56.0.1",
        "fake-indexeddb": "^5.0.2",
        "fetch-mock": "^12.6.0",
        "happy-dom": "^20.8.3",
        "husky": "^9.1.7",
        "knip": "^5.85.0",
        "lint-staged": "^16.3.2",
        "matrix-mock-request": "^2.6.0",
        "prettier": "3.8.1",
        "rimraf": "^6.1.3",
        "typedoc": "^0.28.17",
        "typedoc-plugin-coverage": "^4.0.2",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typedoc-plugin-missing-exports": "^4.1.2",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18",
        "vitest-sonar-reporter": "^3.0.0"
    },
    "resolutions": {
        "expect": "30.2.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "allowedVersions": {
                "eslint": "8"
            }
        },
        "allowedDeprecatedVersions": {
            "eslint": "8"
        }
    },
    "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
