{
    "compilerOptions": {
        "target": "es2022",
        "experimentalDecorators": false,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noEmit": true,
        "declaration": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "lib": ["esnext", "dom", "dom.iterable"],
        "types": ["vitest/globals", "node"],

        // 严格模式
        "noImplicitAny": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,

        // 增量编译优化
        "incremental": true,
        "tsBuildInfoFile": "node_modules/.tsbuildinfo",

        "paths": {
            "#types/*": ["./node_modules/vite/types/*"]
        }
    },
    "include": ["./src/**/*.ts", "./src/**/*.d.ts", "./spec/**/*.ts"],
    "exclude": ["spec/integ/real-backend/**/*", "spec/integ/sliding-sync-sdk.spec.ts", "spec/unit/account.spec.ts"]
}
