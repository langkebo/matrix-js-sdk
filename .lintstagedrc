{
    "{src,spec,perf,scripts}/**/*.(ts|tsx)": ["eslint --fix"],
    "*.(ts|tsx)": ["prettier --write"],
    "*.(mts|cts)": ["prettier --write"],
    "*.(py|md|yaml|yml)": ["prettier --write"],
    "*.(mjs|cjs|js)": ["prettier --write"],
    "{package.json,CLAUDE.md,AGENTS.md,src/**,docs/api-contract/**}": "node scripts/quality/check-docs-counts.mjs"
}
